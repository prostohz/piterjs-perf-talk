{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "resolveJsonModule": true,
    "paths": {
      "measured-dayjs": ["./library/types/index.d.ts"],
      "measured-utc": ["./library/types/plugin/utc.d.ts"],
      "measured-timezone": ["./library/types/plugin/timezone.d.ts"],
      "measured-custom-parse": [
        "./library/types/plugin/customParseFormat.d.ts"
      ],
      "measured-relative": ["./library/types/plugin/relativeTime.d.ts"],
      "measured-localized": ["./library/types/plugin/localizedFormat.d.ts"],
      "dayjs": ["./library/types/index.d.ts"]
    }
  },
  "include": ["target.ts", "harness/**/*.ts"],
  "exclude": ["library", "harness/node_modules"]
}
